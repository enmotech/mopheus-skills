# Default: all text files use LF
* text=auto eol=lf

# Explicitly text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
